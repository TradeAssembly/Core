    "CapabilityRequirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "capability": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "required_for": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReadinessLevel"
          }
        },
        "stage_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StageName"
          }
