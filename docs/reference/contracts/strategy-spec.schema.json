        "constraints": {
          "$ref": "#/$defs/CapabilityConstraints"
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "fallback_policy": {
          "$ref": "#/$defs/FallbackPolicy"
