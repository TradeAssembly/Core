    "StageName": {
      "type": "string",
      "enum": [
        "inputs",
        "universe",
        "evaluate",
        "intent",
        "sizing",
        "risk",
        "exit_policy",
        "order_strategy",
        "price_policy",
        "market_clock"
      ]
    },
    "CapabilityConstraints": {
      "type": "object",
      "properties": {
        "instrument_families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstrumentFamily"
