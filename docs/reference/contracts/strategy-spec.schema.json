    "InstrumentFamily": {
      "type": "string",
      "enum": [
        "equity",
        "fund",
        "crypto_spot",
        "option_contract",
        "future_contract",
        "fixed_income",
        "fx_pair",
        "event_contract",
        "custom"
      ]
    },
    "FallbackPolicy": {
      "type": "string",
      "enum": [
        "none",
        "explicit_only",
        "configured"
      ]
    },
    "SignalMarketRequirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "type": "string"
        },
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "instrument_family": {
          "$ref": "#/$defs/InstrumentFamily"
        },
        "role": {
          "$ref": "#/$defs/SignalMarketRole"
        },
        "data_shapes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "timeframes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lookback": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "$ref": "#/$defs/AvailabilityRequirements"
