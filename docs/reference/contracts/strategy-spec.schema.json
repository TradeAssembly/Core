      "properties": {
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
