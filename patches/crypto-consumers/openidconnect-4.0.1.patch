+    fn sign(&self, alg: &CoreJwsSigningAlgorithm, message: &[u8]) -> Result<Vec<u8>, SigningError> {
+        let encoding: &dyn ring::signature::RsaEncoding = match alg {
+            CoreJwsSigningAlgorithm::RsaSsaPkcs1V15Sha256 => &ring::signature::RSA_PKCS1_SHA256,
+            CoreJwsSigningAlgorithm::RsaSsaPkcs1V15Sha384 => &ring::signature::RSA_PKCS1_SHA384,
+            CoreJwsSigningAlgorithm::RsaSsaPkcs1V15Sha512 => &ring::signature::RSA_PKCS1_SHA512,
+            CoreJwsSigningAlgorithm::RsaSsaPssSha256 => &ring::signature::RSA_PSS_SHA256,
+            CoreJwsSigningAlgorithm::RsaSsaPssSha384 => &ring::signature::RSA_PSS_SHA384,
+            CoreJwsSigningAlgorithm::RsaSsaPssSha512 => &ring::signature::RSA_PSS_SHA512,
+            other => {
+                return Err(SigningError::UnsupportedAlg(
+                    serde_plain::to_string(other).unwrap(),
+                ))
+            }
+        };
+        let mut signature = vec![0; self.key_pair.public().modulus_len()];
+        self.key_pair
+            .sign(
+                encoding,
+                &ring::rand::SystemRandom::new(),
+                message,
+                &mut signature,
+            )
+            .map_err(|_| SigningError::CryptoError)?;
+        Ok(signature)
+    }
