{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tradeassembly.org/plugin-package-1.schema.json",
  "title": "TradeAssembly Plugin Package Descriptor",
  "description": "The immutable descriptor at tradeassembly-plugin.json in a plugin package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageContractVersion",
    "plugin",
    "manifest",
    "targets",
    "responseSchemas",
    "compatibility"
  ],
  "properties": {
    "packageContractVersion": { "const": "1" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "manifest": { "$ref": "#/$defs/digestedPath" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "binary"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "binary": { "$ref": "#/$defs/digestedPath" }
        }
      }
    },
    "responseSchemas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaRef", "document"],
        "properties": {
          "schemaRef": { "type": "string", "minLength": 1 },
          "document": { "$ref": "#/$defs/digestedPath" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostContract", "sdkVersion"],
      "properties": {
        "hostContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "string", "minLength": 1 },
            "maximum": { "type": "string", "minLength": 1 }
          }
        },
        "sdkVersion": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "digestedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
