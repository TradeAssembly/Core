{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tradeassembly.example/indicator-context/request.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "tradeassembly.indicator_context_request.v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "strategyVersionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "strategySpecHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "strategyId",
        "strategyVersionId",
        "strategySpecHash"
      ]
    },
    "planRevisionId": {
      "type": "string",
      "pattern": "^dataplan_[a-f0-9]{64}$"
    },
    "recipeInstanceId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pluginInstanceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "packageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "byteSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canonicalSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "canonicalization": {
              "const": "tradeassembly.canonical-json.v1"
            }
          },
          "required": [
            "schemaVersion",
            "byteSha256",
            "canonicalSha256",
            "canonicalization"
          ]
        },
        "conceptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "recipe": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "recipeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "semanticsVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "canonicalSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "documentSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "recipeId",
                "semanticsVersion",
                "canonicalSha256",
                "documentSha256"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedOutputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "pluginInstanceRef",
        "packageSha256",
        "catalog",
        "conceptId",
        "profileId",
        "profileVersion",
        "recipe",
        "selectedOutputs"
      ]
    },
    "subjectInstrumentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "evaluation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "receiptSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "step": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                },
                "planRevisionId": {
                  "type": "string",
                  "pattern": "^dataplan_[a-f0-9]{64}$"
                },
                "window": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "eventStartMs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "eventEndMs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "asOfMs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "eventStartMs",
                    "eventEndMs",
                    "asOfMs"
                  ]
                },
                "expectedCheckpointSha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "runId",
                "planRevisionId",
                "window",
                "expectedCheckpointSha256"
              ]
            }
          },
          "required": [
            "receiptSha256",
            "step"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "allowEstimates": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "scope",
    "planRevisionId",
    "recipeInstanceId",
    "selection",
    "subjectInstrumentId",
    "evaluation",
    "allowEstimates"
  ]
}
